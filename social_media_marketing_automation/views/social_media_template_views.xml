<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_social_media_template_list" model="ir.ui.view">
        <field name="name">social.media.template.list</field>
        <field name="model">social.media.template</field>
        <field name="arch" type="xml">
            <tree string="Post Templates">
                <field name="name"/>
                <field name="platform"/>
                <field name="link_url"/>
            </tree>
        </field>
    </record>

    <record id="view_social_media_template_form" model="ir.ui.view">
        <field name="name">social.media.template.form</field>
        <field name="model">social.media.template</field>
        <field name="arch" type="xml">
            <form string="Social Media Post Template">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Template name"/>
                        </h1>
                    </div>
                    <group>
                        <field name="platform"/>
                        <field name="link_url" widget="url"/>
                    </group>
                    <group>
                        <field name="message" placeholder="What do you want to share?"/>
                        <field name="image" widget="image" class="oe_avatar"/>
                        <field name="hashtag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_social_media_template" model="ir.actions.act_window">
        <field name="name">Templates</field>
        <field name="res_model">social.media.template</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first post template
            </p>
            <p>
                Save recurring message/image/hashtag combinations to reuse when composing posts.
            </p>
        </field>
    </record>
</odoo>
