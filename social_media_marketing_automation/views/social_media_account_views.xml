<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_social_media_account_list" model="ir.ui.view">
        <field name="name">social.media.account.list</field>
        <field name="model">social.media.account</field>
        <field name="arch" type="xml">
            <tree string="Social Media Accounts" decoration-muted="active == False">
                <field name="name"/>
                <field name="platform"/>
                <field name="handle"/>
                <field name="state" widget="badge" decoration-success="state == 'connected'"/>
                <field name="test_mode"/>
                <field name="post_count"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="view_social_media_account_form" model="ir.ui.view">
        <field name="name">social.media.account.form</field>
        <field name="model">social.media.account</field>
        <field name="arch" type="xml">
            <form string="Social Media Account">
                <header>
                    <button
                        name="action_connect"
                        string="Mark as Connected"
                        type="object"
                        class="oe_highlight"
                        invisible="state == 'connected'"
                    />
                    <button
                        name="action_disconnect"
                        string="Disconnect"
                        type="object"
                        invisible="state == 'disconnected'"
                    />
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_posts"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-file-text-o"
                        >
                            <field name="post_count" widget="statinfo" string="Posts"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Account name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="platform"/>
                            <field name="handle"/>
                            <field name="profile_url" widget="url"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="test_mode"/>
                            <field
                                name="access_token"
                                password="True"
                                invisible="test_mode"
                                groups="social_media_marketing_automation.group_social_media_manager"
                            />
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_social_media_account_kanban" model="ir.ui.view">
        <field name="name">social.media.account.kanban</field>
        <field name="model">social.media.account</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="platform"/>
                <field name="handle"/>
                <field name="state"/>
                <field name="post_count"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <strong><field name="name"/></strong>
                            <div class="text-muted">
                                <field name="platform"/> - <field name="handle"/>
                            </div>
                            <div>
                                <field name="state" widget="badge"/>
                                <span class="float-end">
                                    <field name="post_count"/> posts
                                </span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_social_media_account_search" model="ir.ui.view">
        <field name="name">social.media.account.search</field>
        <field name="model">social.media.account</field>
        <field name="arch" type="xml">
            <search string="Search Accounts">
                <field name="name"/>
                <field name="handle"/>
                <filter string="Connected" name="connected" domain="[('state', '=', 'connected')]"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Platform" name="group_platform" context="{'group_by': 'platform'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_social_media_account" model="ir.actions.act_window">
        <field name="name">Accounts</field>
        <field name="res_model">social.media.account</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="context">{'search_default_connected': 0}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Connect your first social media account
            </p>
            <p>
                Add the Facebook, Instagram, X, LinkedIn, TikTok or YouTube accounts
                you want to plan and publish posts for.
            </p>
        </field>
    </record>
</odoo>
